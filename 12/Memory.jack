/**
 * This library provides two services: direct access to the computer's main
 * memory (RAM), and allocation and recycling of memory blocks. The Hack RAM
 * consists of 32,768 words, each holding a 16-bit binary number.
 */ 
class Memory {

    static Array ram;
    static Array heap;
    static int freeList;

    /** Initializes the class. */
    function void init() {
        let ram = 0;
        let heap = 2048; // base of heap
        let freeList = heap;
        let heap[0] = 0; // no next block
        let heap[1] = 14334; // length of heap
        return;
    }

    /** Returns the RAM value at the given address. */
    function int peek(int address) {
        return ram[address];
    }

    /** Sets the RAM value at the given address to the given value. */
    function void poke(int address, int value) {
        let ram[address] = value;
        return;
    }

    /** Finds an available RAM block of the given size and returns
     *  a reference to its base address. */
    function int alloc(int size) {
        var int prevBase, currentBase, currentSize, nextBase;
        var boolean foundMatch;

        if (size < 1) {
            do Sys.error(5);
        }

        let size = size + 1; // to add the block size before the data

        let currentBase = freeList;
        let currentSize = ram[currentBase + 1];

        while (~foundMatch) {
            if ((currentSize = size) | (currentSize > (size + 1))) {
                let foundMatch = true;
            } else {
                if (ram[currentBase] = 0) {
                    do Sys.error(6); // no block large enough
                }
                let prevBase = currentBase;
                let currentBase = ram[currentBase];
                let currentSize = ram[currentBase + 1];
            }
        }

        if (currentSize = size) { // if perfect fit, remove block from free list
            let nextBase = ram[currentBase];
            if (prevBase = 0) {
                let freeList = nextBase;
            } else {
                let ram[prevBase] = nextBase;
            }
            let ram[currentBase] = size - 1;
            return currentBase + 1;
        }

        // carve from the back of the block
        let ram[currentBase + 1] = ram[currentBase + 1] - size;
        let ram[currentBase + currentSize - size] = size - 1;
        return currentBase + currentSize - size + 1;
    }

    /** De-allocates the given object (cast as an array) by making
     *  it available for future allocations. */
    function void deAlloc(Array o) {
        var int prevBase, nextBase;
        var boolean lastBlock, nextToPrev, nextToNext;

        let nextBase = freeList;

        while ((nextBase < o) & (~lastBlock)) {
            let prevBase = nextBase;
            let nextBase = ram[nextBase];
            if (nextBase = 0) {
                let lastBlock = true;
            }
        }

        let nextToPrev = (prevBase + ram[prevBase + 1] = o);
        let nextToNext = (o + ram[o - 1] = nextBase);

        if (lastBlock) {
            if (nextToPrev) { // if this block is next to the last block in the linked list
                let ram[prevBase + 1] = ram[prevBase + 1] + ram[o - 1] + 1; // merge the two blocks
            } else {
                let ram[prevBase] = o - 1; // add this block to end of linked list
                let ram[o] = ram[o - 1]; // move size up a word
                let ram[o - 1] = 0; // set next to none
            }
        } else {
            if (nextToPrev & nextToNext) {
                let ram[prevBase] = ram[nextBase];
                let ram[prevBase + 1] = nextBase - prevBase + ram[nextBase + 1];
            }
            if (nextToPrev & ~nextToNext) {
                let ram[prevBase + 1] = ram[prevBase + 1] + ram[o - 1] + 1;
            }
            if (~nextToPrev & nextToNext) {
                let ram[o] = ram[nextBase + 1] + ram[o - 1] + 1;
                let ram[o - 1] = ram[nextBase];
            }
            if (~nextToPrev & ~nextToNext) {
                let ram[o] = ram[o - 1] + 1;
                let ram[prevBase] = o - 1; // add this block to linked list
                let ram[o - 1] = nextBase; // point to next block in linked list
            }
        }
        return;
    }    
}
