// File name: projects/1/Mux16.hdl
/**
 * 16-bit multiplexor: 
 * for i = 0, ..., 15:
 * if (sel = 0) out[i] = a[i], else out[i] = b[i]
 */
CHIP Mux16 {
    IN a[16], b[16], sel;
    OUT out[16];

    PARTS:

    Expand16(in=sel, out=SelExpanded);
    
    Not16(in=a, out=Nota);
    Not16(in=b, out=Notb);
    Not16(in=SelExpanded, out=Notsel);
    
    And16(a=a, b=Notsel, out=OutAsel);
    And16(a=b, b=SelExpanded, out=OutBsel);

    Or16(a=OutAsel, b=OutBsel, out=out);

    // Expand16(in=sel, out=SelExpanded);
    
    // Not16(in=SelExpanded, out=Notsel);
    
    // And16(a=a, b=Notsel, out=OutAsel);
    // And16(a=b, b=SelExpanded, out=OutBsel);

    // Or16(a=OutAsel, b=OutBsel, out=out);
}
