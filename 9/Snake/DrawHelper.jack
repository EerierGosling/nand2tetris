    function void startScreen() { // writes start screen
        do Screen.clearScreen();

        do Output.moveCursor(6, 21);
        do Output.printString("Welcome to Snake!");
        do Output.moveCursor(8, 17);
        do Output.printString("Use the arrow keys to move.");
        do Output.moveCursor(10, 19);
        do Output.printString("Press any key to start");
        return;
    }

    function void gameOver(int score) { // writes game over screen with score
        do Screen.clearScreen();

        do Output.moveCursor(6, 26);
        do Output.printString("Game Over!");
        do Output.moveCursor(8, 23);
        do Output.printString("Your score is: ");
        do Output.printInt(score);
        do Output.moveCursor(10, 17);
        do Output.printString("Press any key to play again");
        return;
    }
}